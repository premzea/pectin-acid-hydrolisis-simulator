# Pectin Hydrolysis Digital Twin System
# Dyad Studio Declarative System Model
# Visual layout, component placement, and signal/material flow connections.

component PectinHydrolysisSystem
    # System Components
    feedstock = FeedstockSource(
        dry_matter_mass = 1.0,
        moisture_fraction = 0.10,
        pectin_mass = 0.233,
        GalA_fraction = 0.78,
        DE = 0.745,
        Mw_matrix = 654000.0,
        d50_um = 300.0
    ) {
        "Dyad": {
            "placement": {
                "diagram": {
                    "iconName": "default",
                    "x1": 120, "y1": 120,
                    "x2": 240, "y2": 240,
                    "rot": 0
                }
            },
            "icons": {
                "default": "dyad://PectinComponents/FeedstockSource.svg"
            },
            "tags": ["biomass", "feedstock", "passiflora"]
        }
    }

    acid_doser = AcidDoser(
        pH_target = 2.0,
        citric_acid_conc = 0.0
    ) {
        "Dyad": {
            "placement": {
                "diagram": {
                    "iconName": "default",
                    "x1": 120, "y1": 340,
                    "x2": 240, "y2": 460,
                    "rot": 0
                }
            },
            "icons": {
                "default": "dyad://PectinComponents/AcidDoser.svg"
            },
            "tags": ["dosing", "pH", "acid"]
        }
    }

    thermal_jacket = ThermalJacket(
        T_setpoint_c = 80.0,
        ramp_rate_c_min = 2.5
    ) {
        "Dyad": {
            "placement": {
                "diagram": {
                    "iconName": "default",
                    "x1": 460, "y1": 80,
                    "x2": 580, "y2": 200,
                    "rot": 0
                }
            },
            "icons": {
                "default": "dyad://PectinComponents/ThermalJacket.svg"
            },
            "tags": ["thermal", "jacket", "utility"]
        }
    }

    reactor = BatchHydrolysisReactor(
        k_ref_ext = 0.035,
        Ea_ext = 45000.0,
        k_ref_hyd = 0.015,
        Ea_hyd = 65000.0,
        k_ref_deg = 0.005,
        Ea_deg = 75000.0,
        k_ref_de = 0.012,
        Ea_de = 50000.0
    ) {
        "Dyad": {
            "placement": {
                "diagram": {
                    "iconName": "default",
                    "x1": 440, "y1": 280,
                    "x2": 600, "y2": 460,
                    "rot": 0
                }
            },
            "icons": {
                "default": "dyad://PectinComponents/BatchHydrolysisReactor.svg"
            },
            "tags": ["reactor", "cstr", "kinetics", "core"]
        }
    }

    sensors = SensorArray(
        sigma_A284 = 0.015,
        sigma_Brix = 0.08,
        sigma_NIR = 0.005
    ) {
        "Dyad": {
            "placement": {
                "diagram": {
                    "iconName": "default",
                    "x1": 780, "y1": 180,
                    "x2": 900, "y2": 300,
                    "rot": 0
                }
            },
            "icons": {
                "default": "dyad://PectinComponents/SensorArray.svg"
            },
            "tags": ["sensors", "soft_sensor", "spectroscopy"]
        }
    }

    fractionator = PectinFractions(
        recovery_efficiency = 0.90
    ) {
        "Dyad": {
            "placement": {
                "diagram": {
                    "iconName": "default",
                    "x1": 780, "y1": 360,
                    "x2": 900, "y2": 500,
                    "rot": 0
                }
            },
            "icons": {
                "default": "dyad://PectinComponents/PectinFractions.svg"
            },
            "tags": ["separation", "fractions", "recovery"]
        }
    }

    # Inter-component relations & signal edges
    relations
        connect(feedstock.out_solid, reactor.in_feed) {
            "Dyad": {
                "edges": [
                    {
                        "S": 1,
                        "M": [{"x": 340, "y": 180}, {"x": 340, "y": 320}],
                        "E": 2
                    }
                ]
            }
        }
        connect(acid_doser.out_liquid, reactor.in_acid) {
            "Dyad": {
                "edges": [
                    {
                        "S": 1,
                        "M": [{"x": 340, "y": 400}, {"x": 340, "y": 380}],
                        "E": 2
                    }
                ]
            }
        }
        connect(thermal_jacket.out_fluid, reactor.in_thermal) {
            "Dyad": {
                "edges": [
                    {
                        "S": 1,
                        "M": [{"x": 520, "y": 200}, {"x": 520, "y": 280}],
                        "E": 2
                    }
                ]
            }
        }
        connect(reactor.out_slurry, sensors.in_sample) {
            "Dyad": {
                "edges": [
                    {
                        "S": 1,
                        "M": [{"x": 690, "y": 370}, {"x": 690, "y": 240}],
                        "E": 2
                    }
                ]
            }
        }
        connect(reactor.out_slurry, fractionator.in_slurry) {
            "Dyad": {
                "edges": [
                    {
                        "S": 1,
                        "M": [{"x": 690, "y": 370}, {"x": 690, "y": 430}],
                        "E": 2
                    }
                ]
            }
        }
    end

    metadata {
        "Dyad": {
            "description": "Passion-Fruit Rind Pectin Acid Hydrolysis Multiphysics Model & Digital Twin",
            "canvas": {
                "width": 1200,
                "height": 650,
                "gridSize": 20
            }
        }
    }
end
