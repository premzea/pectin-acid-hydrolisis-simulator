    "id6": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}}
  }
}
end

"Kinetic Chemical Mass State Pool"
component KineticPool
  parameter initial_mass::Real = 0.0
  in_flux = ChemicalFlux() {^in_flux}
  out_flux = ChemicalFlux() {^out_flux}
  variable mass::Real
relations
  initial mass = initial_mass
  der(mass) = in_flux.m_flux - out_flux.m_flux
  out_flux.conc = mass
metadata {
  "Dyad": {"icons": {"default": "dyad://PectinDyad/Pool_Sol.svg"}},
  "_links": {
    "in_flux": {
      "Dyad": {"placement": {"icon": {"x1": -100, "y1": 450, "x2": 0, "y2": 550, "rot": 0}, "diagram": {"x1": -100, "y1": 450, "x2": 0, "y2": 550, "rot": 0}}}
    },
    "out_flux": {
      "Dyad": {"placement": {"icon": {"x1": 1000, "y1": 450, "x2": 1100, "y2": 550, "rot": 0}, "diagram": {"x1": 1000, "y1": 450, "x2": 1100, "y2": 550, "rot": 0}}}
    }
  }
}
end

"Reaction Step Rate Converter"
component ReactionStep
  parameter k::Real = 0.015
  in_flux = ChemicalFlux() {^in_flux}
  out_flux = ChemicalFlux() {^out_flux}
  variable r::Real
relations
  r = k * in_flux.conc
  in_flux.m_flux = r
  out_flux.m_flux = r
metadata {
  "Dyad": {"icons": {"default": "dyad://PectinDyad/ReactionFlux.svg"}},
  "_links": {
    "in_flux": {
      "Dyad": {"placement": {"icon": {"x1": -100, "y1": 450, "x2": 0, "y2": 550, "rot": 0}, "diagram": {"x1": -100, "y1": 450, "x2": 0, "y2": 550, "rot": 0}}}
    },
    "out_flux": {
      "Dyad": {"placement": {"icon": {"x1": 1000, "y1": 450, "x2": 1100, "y2": 550, "rot": 0}, "diagram": {"x1": 1000, "y1": 450, "x2": 1100, "y2": 550, "rot": 0}}}
    }
  }
}
end
