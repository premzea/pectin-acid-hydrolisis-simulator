"Process Stream Connector"
connector ProcessStream
  flow m_flow::Real
  potential conc::Real
end

"Thermal Port Connector"
connector ThermalPort
  flow heat_flow::Real
  potential temp::Real
end

"Pectin Acid Hydrolysis Digital Twin System"
component PectinHydrolysisSystem
  feedstock = FeedstockSource() {^feedstock}
  acid_doser = AcidDoser() {^acid_doser}
  thermal_jacket = ThermalJacket() {^thermal_jacket}
  reactor = BatchHydrolysisReactor() {^reactor}
  sensors = SensorArray() {^sensors}
  fractionator = PectinFractions() {^fractionator}
relations
  connect(feedstock.out_solid, reactor.in_feed) {^id1}
  connect(acid_doser.out_acid, reactor.in_acid) {^id2}
  connect(thermal_jacket.out_thermal, reactor.in_thermal) {^id3}
  connect(reactor.out_slurry, sensors.in_sample) {^id4}
  connect(reactor.out_slurry, fractionator.in_slurry) {^id5}
metadata {
  "Dyad": {"icons": {"default": "dyad://PectinDyad/BatchHydrolysisReactor.svg"}},
  "_links": {
    "feedstock": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 100, "y1": 100, "x2": 220, "y2": 220, "rot": 0}
        },
        "tags": []
      }
    },
    "acid_doser": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 100, "y1": 320, "x2": 220, "y2": 440, "rot": 0}
        },
