"""
Pectin Acid Hydrolysis Digital Twin System

Models the continuous/batch acid hydrolysis cascade for passion fruit rind pectin
extraction. Integrates solid biomass feed, acid dosing, thermal jacket control,
the 4-pool reaction kinetic core, inline multi-sensor telemetry (Brix, A284, NIR),
and downstream pectin fractionation.
"""
component PectinHydrolysisSystem
  "Biomass feedstock feed hopper"
  feedstock = FeedstockSource(
    dry_matter_mass = 1.0,
    moisture_fraction = 0.10,
    pectin_mass = 0.233,
    GalA_fraction = 0.78,
    DE = 0.745,
    Mw_matrix = 654000.0,
    d50_um = 300.0
  ) {^feedstock}

  "Acid metering and pH regulation unit"
  acid_doser = AcidDoser(
    pH_target = 2.0,
    citric_acid_conc = 0.0
  ) {^acid_doser}

  "Thermal utility jacket circulator"
  thermal_jacket = ThermalJacket(
    T_setpoint_c = 80.0,
    ramp_rate_c_min = 2.5
  ) {^thermal_jacket}

  "Core 4-pool acid hydrolysis batch reactor"
  reactor = BatchHydrolysisReactor(
    k_ref_ext = 0.035,
    Ea_ext = 45000.0,
    k_ref_hyd = 0.015,
    Ea_hyd = 65000.0,
    k_ref_deg = 0.005,
    Ea_deg = 75000.0,
    k_ref_de = 0.012,
    Ea_de = 50000.0
  ) {^reactor}

  "Inline multi-channel soft sensor array"
  sensors = SensorArray(
    sigma_A284 = 0.015,
    sigma_Brix = 0.08,
    sigma_NIR = 0.005
  ) {^sensors}

  "Downstream pectin fractionation and recovery unit"
  fractionator = PectinFractions(
    recovery_efficiency = 0.90
  ) {^fractionator}

relations
  connect(feedstock.out_solid, reactor.in_feed) {^id1}
  connect(acid_doser.out_liquid, reactor.in_acid) {^id2}
  connect(thermal_jacket.out_fluid, reactor.in_thermal) {^id3}
  connect(reactor.out_slurry, sensors.in_sample) {^id4}
  connect(reactor.out_slurry, fractionator.in_slurry) {^id5}

metadata {
  "Dyad": {
    "icons": {"default": "dyad://PectinComponents/BatchHydrolysisReactor.svg"}
  },
  "_links": {
    "feedstock": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 120, "y1": 120, "x2": 240, "y2": 240, "rot": 0}
        },
        "tags": ["biomass", "feedstock"]
      }
    },
    "acid_doser": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 120, "y1": 340, "x2": 240, "y2": 460, "rot": 0}
        },
        "tags": ["acid", "dosing"]
      }
    },
    "thermal_jacket": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 460, "y1": 80, "x2": 580, "y2": 200, "rot": 0}
        },
        "tags": ["thermal", "utility"]
      }
    },
    "reactor": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 440, "y1": 280, "x2": 600, "y2": 460, "rot": 0}
        },
        "tags": ["reactor", "kinetics", "core"]
      }
    },
    "sensors": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 780, "y1": 180, "x2": 900, "y2": 300, "rot": 0}
        },
        "tags": ["sensors", "soft_sensor"]
      }
    },
    "fractionator": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 780, "y1": 360, "x2": 900, "y2": 500, "rot": 0}
        },
        "tags": ["separation", "fractions"]
      }
    },
    "id1": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 340, "y": 180}, {"x": 340, "y": 320}], "E": 2}], "renderStyle": "standard"}},
    "id2": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 340, "y": 400}, {"x": 340, "y": 380}], "E": 2}], "renderStyle": "standard"}},
    "id3": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 520, "y": 200}, {"x": 520, "y": 280}], "E": 2}], "renderStyle": "standard"}},
    "id4": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 690, "y": 370}, {"x": 690, "y": 240}], "E": 2}], "renderStyle": "standard"}},
    "id5": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 690, "y": 370}, {"x": 690, "y": 430}], "E": 2}], "renderStyle": "standard"}}
  }
}
end
