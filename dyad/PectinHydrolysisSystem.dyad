"Solid Biomass Feedstock Source"
component FeedstockSource
  parameter dry_matter_mass::Real = 1.0
  parameter pectin_mass::Real = 0.233
  parameter DE::Real = 0.745
  parameter Mw::Real = 654000.0
  out_solid = ProcessStream() {^out_solid}
relations
  out_solid.m_flow = -dry_matter_mass
  out_solid.conc = pectin_mass
metadata {
  "Dyad": {
    "icons": {"default": "dyad://PectinDyad/FeedstockSource.svg"}
  },
  "_links": {
    "out_solid": {
      "Dyad": {
        "placement": {
          "icon": {"iconName": "default", "x1": 1000, "y1": 450, "x2": 1100, "y2": 550, "rot": 0},
          "diagram": {"iconName": "default", "x1": 1000, "y1": 450, "x2": 1100, "y2": 550, "rot": 0}
        }
      }
    }
  }
}
end

"Acid Dosing Unit"
component AcidDoser
  parameter pH_target::Real = 2.0
  out_acid = ProcessStream() {^out_acid}
relations
  out_acid.m_flow = -0.05
  out_acid.conc = pH_target
metadata {
  "Dyad": {
    "icons": {"default": "dyad://PectinDyad/AcidDoser.svg"}
  },
  "_links": {
    "out_acid": {
      "Dyad": {
        "placement": {
          "icon": {"iconName": "default", "x1": 1000, "y1": 450, "x2": 1100, "y2": 550, "rot": 0},
          "diagram": {"iconName": "default", "x1": 1000, "y1": 450, "x2": 1100, "y2": 550, "rot": 0}
        }
      }
    }
  }
}
end

"Thermal Utility Jacket"
component ThermalJacket
  parameter T_setpoint::Real = 80.0
  out_thermal = ThermalPort() {^out_thermal}
relations
  out_thermal.temp = T_setpoint
  out_thermal.heat_flow = -150.0
metadata {
  "Dyad": {
    "icons": {"default": "dyad://PectinDyad/ThermalJacket.svg"}
  },
  "_links": {
    "out_thermal": {
      "Dyad": {
        "placement": {
          "icon": {"iconName": "default", "x1": 500, "y1": 1000, "x2": 600, "y2": 1100, "rot": 0},
          "diagram": {"iconName": "default", "x1": 500, "y1": 1000, "x2": 600, "y2": 1100, "rot": 0}
        }
      }
    }
  }
}
end

"Batch Hydrolysis Reactor Core"
component BatchHydrolysisReactor
  parameter k_hyd::Real = 0.015
  parameter Ea_hyd::Real = 65000.0
  in_feed = ProcessStream() {^in_feed}
  in_acid = ProcessStream() {^in_acid}
  in_thermal = ThermalPort() {^in_thermal}
  out_slurry = ProcessStream() {^out_slurry}
  variable P_sol::Real
  variable P_lowMW::Real
relations
  initial P_sol = 0.233
  initial P_lowMW = 0.0
  der(P_sol) = -k_hyd * P_sol
  der(P_lowMW) = k_hyd * P_sol
  in_feed.m_flow = 1.0
  in_acid.m_flow = 0.05
  in_thermal.heat_flow = 150.0
  out_slurry.m_flow = -1.05
  out_slurry.conc = P_sol
metadata {
  "Dyad": {
    "icons": {"default": "dyad://PectinDyad/BatchHydrolysisReactor.svg"}
  },
  "_links": {
    "in_feed": {
      "Dyad": {"placement": {"icon": {"iconName": "default", "x1": -100, "y1": 200, "x2": 0, "y2": 300, "rot": 0}, "diagram": {"iconName": "default", "x1": -100, "y1": 200, "x2": 0, "y2": 300, "rot": 0}}}
    },
    "in_acid": {
      "Dyad": {"placement": {"icon": {"iconName": "default", "x1": -100, "y1": 700, "x2": 0, "y2": 800, "rot": 0}, "diagram": {"iconName": "default", "x1": -100, "y1": 700, "x2": 0, "y2": 800, "rot": 0}}}
    },
    "in_thermal": {
      "Dyad": {"placement": {"icon": {"iconName": "default", "x1": 500, "y1": -100, "x2": 600, "y2": 0, "rot": 0}, "diagram": {"iconName": "default", "x1": 500, "y1": -100, "x2": 600, "y2": 0, "rot": 0}}}
    },
    "out_slurry": {
      "Dyad": {"placement": {"icon": {"iconName": "default", "x1": 1000, "y1": 450, "x2": 1100, "y2": 550, "rot": 0}, "diagram": {"iconName": "default", "x1": 1000, "y1": 450, "x2": 1100, "y2": 550, "rot": 0}}}
    }
  }
}
end

"Soft Sensor Suite"
component SensorArray
  in_sample = ProcessStream() {^in_sample}
  variable A284::Real
  variable Brix::Real
relations
  in_sample.m_flow = 0.0
  A284 = 0.5 * in_sample.conc
  Brix = 10.0 * in_sample.conc
metadata {
  "Dyad": {
    "icons": {"default": "dyad://PectinDyad/SensorArray.svg"}
  },
  "_links": {
    "in_sample": {
      "Dyad": {"placement": {"icon": {"iconName": "default", "x1": -100, "y1": 450, "x2": 0, "y2": 550, "rot": 0}, "diagram": {"iconName": "default", "x1": -100, "y1": 450, "x2": 0, "y2": 550, "rot": 0}}}
    }
  }
}
end

"Pectin Fractionation Separator"
component PectinFractions
  in_slurry = ProcessStream() {^in_slurry}
  parameter efficiency::Real = 0.90
  variable yield_sol::Real
relations
  in_slurry.m_flow = 1.05
  yield_sol = efficiency * in_slurry.conc
metadata {
  "Dyad": {
    "icons": {"default": "dyad://PectinDyad/PectinFractions.svg"}
  },
  "_links": {
    "in_slurry": {
      "Dyad": {"placement": {"icon": {"iconName": "default", "x1": -100, "y1": 450, "x2": 0, "y2": 550, "rot": 0}, "diagram": {"iconName": "default", "x1": -100, "y1": 450, "x2": 0, "y2": 550, "rot": 0}}}
    }
  }
}
end