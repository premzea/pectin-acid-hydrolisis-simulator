"""
PectinComponents Library

Reusable acausal process components for passion fruit rind acid hydrolysis,
mass transfer, thermal dynamics, optical soft-sensors, and recovery.
"""
package PectinComponents

"Solid feedstock biomass feed hopper"
component FeedstockSource
  parameter dry_matter_mass = 1.0
  parameter moisture_fraction = 0.10
  parameter pectin_mass = 0.233
  parameter GalA_fraction = 0.78
  parameter DE = 0.745
  parameter Mw_matrix = 654000.0
  parameter d50_um = 300.0

  connector out_solid
    variable flow_rate = 0.0
    variable P_matrix_mass = pectin_mass
  end

metadata {
  "Dyad": {
    "icons": {"default": "dyad://PectinComponents/FeedstockSource.svg"},
    "placement": {
      "diagram": {"iconName": "default", "x1": 0, "y1": 0, "x2": 100, "y2": 100, "rot": 0}
    },
    "ports": {
      "out_solid": {"x": 100, "y": 50, "direction": "out"}
    }
  }
}
end

"Acid reagent dosing and pH regulation pump"
component AcidDoser
  parameter pH_target = 2.0
  parameter citric_acid_conc = 0.0

  connector out_liquid
    variable pH = pH_target
    variable C_citric = citric_acid_conc
  end

metadata {
  "Dyad": {
    "icons": {"default": "dyad://PectinComponents/AcidDoser.svg"},
    "placement": {
      "diagram": {"iconName": "default", "x1": 0, "y1": 0, "x2": 100, "y2": 100, "rot": 0}
    },
    "ports": {
      "out_liquid": {"x": 100, "y": 50, "direction": "out"}
    }
  }
}
end

"Circulating thermostatic bath jacket utility"
component ThermalJacket
  parameter T_setpoint_c = 80.0
  parameter ramp_rate_c_min = 2.5

  connector out_fluid
    variable temperature = T_setpoint_c
  end

metadata {
  "Dyad": {
    "icons": {"default": "dyad://PectinComponents/ThermalJacket.svg"},
    "placement": {
      "diagram": {"iconName": "default", "x1": 0, "y1": 0, "x2": 100, "y2": 100, "rot": 0}
    },
    "ports": {
      "out_fluid": {"x": 50, "y": 100, "direction": "out"}
    }
  }
}
end

"Jacketed stirred-tank batch hydrolysis reactor core"
component BatchHydrolysisReactor
  parameter k_ref_ext = 0.035
  parameter Ea_ext = 45000.0
  parameter n_ext = 1.0
  parameter alpha = 1.0
  parameter k_ref_hyd = 0.015
  parameter Ea_hyd = 65000.0
  parameter n_hyd = 1.0
  parameter k_ref_deg = 0.005
  parameter Ea_deg = 75000.0
  parameter n_deg = 1.0
  parameter k_ref_de = 0.012
  parameter Ea_de = 50000.0
  parameter n_de = 1.0
  parameter beta_mw = 1.0

  connector in_feed
    variable flow_rate
    variable P_matrix_mass
  end

  connector in_acid
    variable pH
    variable C_citric
  end

  connector in_thermal
    variable temperature
  end

  connector out_slurry
    variable P_matrix
    variable P_sol
    variable P_lowMW
    variable P_loss
    variable DE_product
    variable Mw_product
    variable Y_p
  end

metadata {
  "Dyad": {
    "icons": {"default": "dyad://PectinComponents/BatchHydrolysisReactor.svg"},
    "placement": {
      "diagram": {"iconName": "default", "x1": 0, "y1": 0, "x2": 120, "y2": 120, "rot": 0}
    },
    "ports": {
      "in_feed":    {"x": 20, "y": 0, "direction": "in"},
      "in_acid":    {"x": 80, "y": 0, "direction": "in"},
      "in_thermal": {"x": 0,  "y": 60, "direction": "in"},
      "out_slurry": {"x": 120, "y": 60, "direction": "out"}
    }
  }
}
end

"Online optical flow cell with soft-sensor telemetry"
component SensorArray
  parameter sigma_A284 = 0.015
  parameter sigma_Brix = 0.08
  parameter sigma_NIR = 0.005

  connector in_sample
    variable P_sol
    variable P_lowMW
    variable P_loss
    variable DE_product
  end

  connector out_telemetry
    variable A284_signal
    variable Brix_signal
    variable NIR_signal
  end

metadata {
  "Dyad": {
    "icons": {"default": "dyad://PectinComponents/SensorArray.svg"},
    "placement": {
      "diagram": {"iconName": "default", "x1": 0, "y1": 0, "x2": 100, "y2": 100, "rot": 0}
    },
    "ports": {
      "in_sample":     {"x": 0, "y": 50, "direction": "in"},
      "out_telemetry": {"x": 100, "y": 50, "direction": "out"}
    }
  }
}
end

"Downstream pectin fractionation and recovery column"
component PectinFractions
  parameter recovery_efficiency = 0.90

  connector in_slurry
    variable P_sol
    variable P_lowMW
    variable P_loss
    variable DE_product
    variable Mw_product
  end

  connector out_intact_pectin
    variable mass_yield
    variable DE
    variable Mw
  end

metadata {
  "Dyad": {
    "icons": {"default": "dyad://PectinComponents/PectinFractions.svg"},
    "placement": {
      "diagram": {"iconName": "default", "x1": 0, "y1": 0, "x2": 100, "y2": 100, "rot": 0}
    },
    "ports": {
      "in_slurry":         {"x": 0, "y": 50, "direction": "in"},
      "out_intact_pectin": {"x": 100, "y": 50, "direction": "out"}
    }
  }
}
end

end # package PectinComponents
